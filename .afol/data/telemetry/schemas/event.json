{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "telemetry-event-schema-v1",
  "title": "Telemetry Event (AFOL-native)",
  "description": "Schema for AFOL-native telemetry events stored in .afol/data/events/events.jsonl",
  "type": "object",
  "required": ["schema_version", "id", "ts", "source", "event_type", "session_id"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1"],
      "description": "Schema version for forward compatibility"
    },
    "id": {
      "type": "string",
      "pattern": "^TEL-\\d+-\\d{6}$",
      "description": "Unique event identifier (TEL-<timestamp>-<counter>)"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "source": {
      "type": "string",
      "enum": ["afol-cli"],
      "description": "Source component that emitted the event"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "session_start",
        "session_end",
        "task_start",
        "task_complete",
        "tool_exec",
        "error",
        "blocker"
      ],
      "description": "Type of AFOL-native telemetry event"
    },
    "session_id": {
      "type": "string",
      "description": "Workstream session ID (YYMMDD_HHMM_theme)"
    },
    "task_id": {
      "type": "string",
      "pattern": "^T-\\d{2,3}$",
      "description": "Task identifier (T-NN)"
    },
    "cmd_type": {
      "type": "string",
      "description": "Sanitized command type — first token only, never full args or secrets"
    },
    "outcome": {
      "type": "string",
      "enum": ["success", "failure"],
      "description": "Event outcome"
    },
    "note": {
      "type": "string",
      "description": "Human-readable note (no secrets)"
    },
    "error_type": {
      "type": "string",
      "description": "Error or blocker type when event_type is error or blocker"
    }
  }
}
