{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afol.local/schemas/evolution-v1.schema.json",
  "title": "AFOL Evolution v1 State and Evidence",
  "description": "Backward-compatible AFOL project configuration and an export contract for canonical evolution events plus rebuildable projections.",
  "oneOf": [
    { "$ref": "#/$defs/projectConfigDocument" },
    { "$ref": "#/$defs/evolutionStateDocument" }
  ],
  "$defs": {
    "projectConfigDocument": {
      "type": "object",
      "required": ["schema_version", "project", "paths"],
      "properties": {
        "schema_version": { "const": 1 },
        "project": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "id": { "$ref": "#/$defs/projectId" },
            "timezone": { "$ref": "#/$defs/ianaTimezone" }
          },
          "additionalProperties": true
        },
        "paths": {
          "type": "object",
          "properties": {
            "external_dir": { "const": ".afol/external" },
            "evolution_db": { "const": ".afol/state/evolution.db" },
            "evolution_data_dir": { "const": ".afol/data/evolution" },
            "evolution_events_dir": { "const": ".afol/data/events/evolution" }
          },
          "additionalProperties": true
        },
        "evolution": { "$ref": "#/$defs/config" },
        "skills_sync": { "type": "object", "additionalProperties": true },
        "rules": { "type": "object", "additionalProperties": true },
        "hooks": { "type": "object", "additionalProperties": true },
        "adapters": { "type": "object", "additionalProperties": true }
      },
      "allOf": [
        {
          "if": { "required": ["evolution"] },
          "then": {
            "properties": {
              "project": { "type": "object", "required": ["name", "id", "timezone"] },
              "paths": {
                "type": "object",
                "required": ["external_dir", "evolution_db", "evolution_data_dir", "evolution_events_dir"]
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "evolutionStateDocument": {
      "type": "object",
      "required": ["schema_version", "project_id", "project_timezone", "config", "records", "journal"],
      "properties": {
        "schema_version": { "oneOf": [{ "const": "1.0.0" }, { "const": 1 }] },
        "project_id": { "$ref": "#/$defs/projectId" },
        "project_timezone": { "$ref": "#/$defs/ianaTimezone" },
        "config": { "$ref": "#/$defs/config" },
        "records": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/productionDay" },
              { "$ref": "#/$defs/preference" },
              { "$ref": "#/$defs/preferenceEvidence" },
              { "$ref": "#/$defs/observation" },
              { "$ref": "#/$defs/issueCluster" },
              { "$ref": "#/$defs/recurrenceDecision" },
              { "$ref": "#/$defs/suggestion" },
              { "$ref": "#/$defs/proposal" },
              { "$ref": "#/$defs/evaluation" },
              { "$ref": "#/$defs/receipt" },
              { "$ref": "#/$defs/externalImport" },
              { "$ref": "#/$defs/externalSession" },
              { "$ref": "#/$defs/sessionLink" },
              { "$ref": "#/$defs/adoptionCandidate" },
              { "$ref": "#/$defs/evolutionRun" },
              { "$ref": "#/$defs/decisionEvent" },
              { "$ref": "#/$defs/tombstone" }
            ]
          }
        },
        "journal": {
          "type": "array",
          "items": { "$ref": "#/$defs/journalEntry" }
        }
      },
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "ianaTimezone": {
      "type": "string",
      "pattern": "^(?:UTC|(?:[A-Za-z_]+/){1,2}[A-Za-z0-9_+.-]+)$",
      "description": "IANA timezone shape; runtime validation must also resolve it through the platform IANA database. UTC offsets and arbitrary labels are not accepted."
    },
    "date": { "type": "string", "format": "date" },
    "dateTime": { "type": "string", "format": "date-time" },
    "stateClass": {
      "type": "string",
      "enum": ["canonical", "derived"]
    },
    "status": { "type": "string", "minLength": 1 },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": {
            "type": "string",
            "enum": ["session", "task", "evidence", "decision", "report", "claim", "import", "external_session", "observation", "suggestion", "proposal", "journal", "tombstone", "memory", "lesson", "feedback", "telemetry", "test", "commit", "artifact", "source"]
          },
          "path": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "minLength": 1 },
          "authority": { "enum": ["canonical", "derived", "external"] },
          "source_url": { "type": "string", "format": "uri" },
          "accessed_at": { "$ref": "#/$defs/dateTime" }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "source" } }, "required": ["kind"] },
            "then": { "required": ["source_url", "accessed_at"] }
          }
        ],
        "additionalProperties": false
      }
    },
    "baseRecord": {
      "type": "object",
      "required": ["record_type", "id", "state_class", "status", "created_at", "source_refs"],
      "properties": {
        "record_type": { "type": "string" },
        "id": { "$ref": "#/$defs/id" },
        "state_class": { "$ref": "#/$defs/stateClass" },
        "status": { "$ref": "#/$defs/status" },
        "created_at": { "$ref": "#/$defs/dateTime" },
        "updated_at": { "$ref": "#/$defs/dateTime" },
        "source_refs": { "$ref": "#/$defs/sourceRefs" },
        "journal_event_id": { "$ref": "#/$defs/id" },
        "notes": { "type": "string" }
      }
    },
    "config": {
      "type": "object",
      "required": ["enabled", "external", "preferences", "recurrence", "suggestions", "large_change", "autonomy"],
      "properties": {
        "enabled": { "type": "boolean" },
        "external": {
          "type": "object",
          "required": ["mode", "storage", "redact_before_persist", "store_raw"],
          "properties": {
            "mode": { "enum": ["explicit_import_only"] },
            "storage": { "const": "normalized_sections" },
            "redact_before_persist": { "const": true },
            "store_raw": { "const": false }
          },
          "additionalProperties": false
        },
        "preferences": {
          "type": "object",
          "required": ["soft_decay_after_production_days", "stop_guiding_after_production_days", "minimum_effective_confidence", "decay_curve"],
          "properties": {
            "soft_decay_after_production_days": { "const": 7 },
            "stop_guiding_after_production_days": { "const": 20 },
            "minimum_effective_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "decay_curve": { "const": "linear" }
          },
          "additionalProperties": false
        },
        "recurrence": {
          "type": "object",
          "required": ["minimum_occurrences", "minimum_distinct_sessions", "minimum_distinct_production_days"],
          "properties": {
            "minimum_occurrences": { "type": "integer", "minimum": 1 },
            "minimum_distinct_sessions": { "type": "integer", "minimum": 1 },
            "minimum_distinct_production_days": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "suggestions": {
          "type": "object",
          "required": ["first_session_of_day", "dedupe_scope", "max_visible_per_day", "remind_skipped_next_day", "deep_review_after_production_days"],
          "properties": {
            "first_session_of_day": { "type": "boolean" },
            "dedupe_scope": { "const": "project" },
            "max_visible_per_day": { "const": 1 },
            "remind_skipped_next_day": { "type": "boolean" },
            "deep_review_after_production_days": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "large_change": {
          "type": "object",
          "required": ["changed_files", "changed_lines", "critical_paths_trigger"],
          "properties": {
            "changed_files": { "type": "integer", "minimum": 1 },
            "changed_lines": { "type": "integer", "minimum": 1 },
            "critical_paths_trigger": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "autonomy": {
          "type": "object",
          "required": ["auto_observe", "auto_refresh_preference_projections", "auto_clean_derived_state", "auto_apply_mode"],
          "properties": {
            "auto_observe": { "type": "boolean" },
            "auto_refresh_preference_projections": {
              "type": "boolean",
              "description": "Refreshes derived confidence and decay only; it cannot create, reinforce, reject, or globalize a preference."
            },
            "auto_clean_derived_state": { "type": "boolean" },
            "auto_apply_mode": {
              "enum": ["none", "canary", "lessons_memory_only"],
              "default": "canary",
              "description": "none is always allowed; canary is the bounded Slice 7 first-release mode; lessons_memory_only requires successful evaluation and explicit default-change approval."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "productionDay": {
      "allOf": [{ "$ref": "#/$defs/baseRecord" }],
      "properties": {
        "record_type": { "const": "production_day" },
        "state_class": { "const": "derived" },
        "local_date": { "$ref": "#/$defs/date" },
        "ordinal": { "type": "string", "pattern": "^PD-[0-9]{4,}$" },
        "ordinal_sequence": { "type": "integer", "minimum": 1 },
        "qualifying_events": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
      },
      "required": ["local_date", "ordinal", "ordinal_sequence", "qualifying_events", "journal_event_id"]
    },
    "preference": {
      "allOf": [{ "$ref": "#/$defs/baseRecord" }],
      "properties": {
        "record_type": { "const": "preference" },
        "state_class": { "const": "derived" },
        "statement": { "type": "string", "minLength": 1 },
        "scope": { "const": "project" },
        "provenance": { "enum": ["explicit", "inferred", "structural"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "effective_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "last_reinforced_production_day": { "type": "integer", "minimum": 0 },
        "current_production_day": { "type": "integer", "minimum": 0 }
      },
      "required": ["statement", "scope", "provenance", "confidence", "effective_confidence"]
    },
    "preferenceEvidence": {
      "allOf": [
        { "$ref": "#/$defs/baseRecord" },
        {
          "if": {
            "properties": {
              "source_refs": {
                "contains": {
                  "type": "object",
                  "properties": { "kind": { "enum": ["import", "external_session"] } },
                  "required": ["kind"]
                }
              }
            },
            "required": ["source_refs"]
          },
          "then": {
            "properties": {
              "kind": { "const": "external" },
              "trust": { "const": "untrusted" }
            }
          }
        }
      ],
      "properties": {
        "record_type": { "const": "preference_evidence" },
        "state_class": { "const": "derived" },
        "preference_id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["explicit", "inferred", "structural", "external", "accepted", "rejected", "contradiction"] },
        "trust": { "enum": ["local", "untrusted"] },
        "weight": { "type": "number" }
      },
      "required": ["preference_id", "kind", "trust", "weight"]
    },
    "observation": {
      "allOf": [{ "$ref": "#/$defs/baseRecord" }],
      "properties": {
        "record_type": { "const": "observation" },
        "state_class": { "const": "derived" },
        "kind": { "type": "string", "minLength": 1 },
        "fingerprint": { "$ref": "#/$defs/id" },
        "fingerprint_version": { "const": 1 },
        "occurrence_identity": { "$ref": "#/$defs/id" },
        "session_id": { "$ref": "#/$defs/id" },
        "production_day": { "type": "integer", "minimum": 0 },
        "task_type": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "fingerprint", "fingerprint_version", "occurrence_identity", "session_id", "task_type", "impact", "journal_event_id"]
    },
    "issueCluster": {
      "allOf": [{ "$ref": "#/$defs/baseRecord" }],
      "properties": {
        "record_type": { "const": "issue_cluster" },
        "state_class": { "const": "derived" },
        "fingerprint": { "$ref": "#/$defs/id" },
        "fingerprint_version": { "const": 1 },
        "status": { "enum": ["observed", "candidate", "recurring", "proposal_open", "mitigation_canary", "resolved", "reopened", "dismissed"] },
        "occurrence_count": { "type": "integer", "minimum": 1 },
        "distinct_sessions": { "type": "integer", "minimum": 1 },
        "distinct_production_days": { "type": "integer", "minimum": 0 },
        "user_confirmed_recurrence": { "type": "boolean" }
      },
      "required": ["fingerprint", "fingerprint_version", "occurrence_count", "distinct_sessions", "distinct_production_days", "user_confirmed_recurrence", "journal_event_id"]
    },
    "recurrenceDecision": {
      "allOf": [{ "$ref": "#/$defs/baseRecord" }],
      "properties": {
        "record_type": { "const": "recurrence_decision" },
        "state_class": { "const": "canonical" },
        "fingerprint": { "$ref": "#/$defs/id" },
        "fingerprint_version": { "const": 1 },
        "action": { "enum": ["confirm", "dismiss", "reopen"] },
        "observation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "observation_membership_digest": { "$ref": "#/$defs/id" },
        "source_decision_ref": { "$ref": "#/$defs/id" },
        "decision_digest": { "$ref": "#/$defs/id" }
      },
      "required": ["fingerprint", "fingerprint_version", "action", "observation_ids", "observation_membership_digest", "source_decision_ref", "decision_digest", "journal_event_id"]
    },
    "suggestion": {
      "allOf": [{ "$ref": "#/$defs/baseRecord" }],
      "properties": {
        "record_type": { "const": "suggestion" },
        "state_class": { "const": "derived" },
        "project_date": { "$ref": "#/$defs/date" },
        "problem": { "type": "string", "minLength": 1 },
        "risk": { "type": "string", "minLength": 1 },
        "validation": { "type": "string", "minLength": 1 },
        "pending_count": { "type": "integer", "minimum": 0 }
      },
      "required": ["project_date", "problem", "risk", "validation"]
    },
    "proposal": {
      "allOf": [{ "$ref": "#/$defs/baseRecord" }],
      "properties": {
        "record_type": { "const": "proposal" },
        "state_class": { "const": "derived" },
        "problem": { "type": "string", "minLength": 1 },
        "change": { "type": "string", "minLength": 1 },
        "risk": { "type": "string", "minLength": 1 },
        "validation": { "type": "string", "minLength": 1 },
        "baseline": { "type": "object" },
        "target_metrics": { "type": "object" },
        "approval_required": { "type": "boolean" }
      },
      "required": ["problem", "change", "risk", "validation", "baseline", "target_metrics", "approval_required", "journal_event_id"]
    },
    "evaluation": {
      "allOf": [{ "$ref": "#/$defs/baseRecord" }],
      "properties": {
        "record_type": { "const": "proposal_evaluation" },
        "state_class": { "const": "derived" },
        "proposal_id": { "$ref": "#/$defs/id" },
        "state": { "enum": ["canary", "stable", "needs_more_data", "regressed", "rolled_back", "superseded"] },
        "baseline_window": { "type": "object" },
        "target_metrics": { "type": "object" },
        "minimum_comparable_sessions": { "type": "integer", "minimum": 1 },
        "production_day_window": { "type": "integer", "minimum": 1 }
      },
      "required": ["proposal_id", "state", "baseline_window", "target_metrics", "minimum_comparable_sessions", "production_day_window", "journal_event_id"]
    },
    "receipt": {
      "allOf": [{ "$ref": "#/$defs/baseRecord" }],
      "properties": {
        "record_type": { "const": "daily_suggestion_receipt" },
        "state_class": { "const": "derived" },
        "local_date": { "$ref": "#/$defs/date" },
        "suggestion_id": { "$ref": "#/$defs/id" },
        "claimed_by": { "$ref": "#/$defs/id" },
        "claim_token": { "type": "string", "minLength": 32 },
        "generation": { "type": "integer", "minimum": 1 },
        "claim_expires_at": { "$ref": "#/$defs/dateTime" },
        "receipt_status": { "enum": ["claimed", "shown", "skipped", "accepted", "rejected"] }
      },
      "required": ["local_date", "suggestion_id", "claimed_by", "claim_token", "generation", "claim_expires_at", "receipt_status", "journal_event_id"]
    },
    "externalImport": {
      "allOf": [{ "$ref": "#/$defs/baseRecord" }],
      "properties": {
        "record_type": { "const": "external_import" },
        "state_class": { "const": "derived" },
        "provider": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": "string", "minLength": 1 },
        "content_digest": { "type": "string", "minLength": 1 },
        "trust": { "const": "untrusted" },
        "redaction_policy_version": { "type": "string", "minLength": 1 },
        "redacted": { "const": true },
        "raw_stored": { "const": false }
      },
      "required": ["provider", "adapter_version", "content_digest", "trust", "redaction_policy_version", "redacted", "raw_stored", "journal_event_id"]
    },
    "externalSession": {
      "allOf": [{ "$ref": "#/$defs/baseRecord" }],
      "properties": {
        "record_type": { "const": "external_session" },
        "state_class": { "const": "derived" },
        "import_id": { "$ref": "#/$defs/id" },
        "provider_session_id": { "$ref": "#/$defs/id" },
        "trust": { "const": "untrusted" },
        "content_digest": { "type": "string", "minLength": 1 }
      },
      "required": ["import_id", "provider_session_id", "trust", "content_digest", "journal_event_id"]
    },
    "sessionLink": {
      "allOf": [{ "$ref": "#/$defs/baseRecord" }],
      "properties": {
        "record_type": { "const": "session_link" },
        "state_class": { "const": "derived" },
        "link_state": { "enum": ["auto_verified", "manual_confirmed", "pending"] },
        "external_session_id": { "$ref": "#/$defs/id" },
        "afol_session_id": { "$ref": "#/$defs/id" },
        "project_id": { "$ref": "#/$defs/projectId" },
        "verified_commit": { "type": "string", "minLength": 7 },
        "canonical_decision_ref": { "$ref": "#/$defs/id" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "confirmation_required": { "type": "boolean" },
        "eligible_for_learning": { "type": "boolean" }
      },
      "required": ["link_state", "external_session_id", "project_id", "confidence", "confirmation_required", "eligible_for_learning", "journal_event_id"],
      "oneOf": [
        {
          "properties": {
            "link_state": { "const": "auto_verified" },
            "confirmation_required": { "const": false },
            "eligible_for_learning": { "const": true }
          },
          "required": ["afol_session_id", "verified_commit"]
        },
        {
          "properties": {
            "link_state": { "const": "manual_confirmed" },
            "confirmation_required": { "const": false },
            "eligible_for_learning": { "const": true }
          },
          "required": ["afol_session_id", "canonical_decision_ref"]
        },
        {
          "properties": {
            "link_state": { "const": "pending" },
            "confirmation_required": { "const": true },
            "eligible_for_learning": { "const": false }
          }
        }
      ]
    },
    "adoptionCandidate": {
      "allOf": [{ "$ref": "#/$defs/baseRecord" }],
      "properties": {
        "record_type": { "const": "adoption_candidate" },
        "state_class": { "const": "derived" },
        "project_id": { "$ref": "#/$defs/projectId" },
        "session_id": { "$ref": "#/$defs/id" },
        "destination": { "enum": ["memory", "library"] },
        "candidate_type": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "provenance": { "enum": ["explicit", "inferred", "structural", "external"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence_reason": { "type": "string", "minLength": 1 },
        "review_state": { "enum": ["candidate_available", "blocked_missing_evidence", "already_adopted", "stale_or_conflicted"] },
        "conflict_refs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "approval_required": { "const": true },
        "approval_owner": { "enum": ["project_user", "library_reviewer", "memory_reviewer"] },
        "next_action": { "type": "string", "minLength": 1 },
        "project_scope": { "type": "string", "minLength": 1 },
        "explicitness": { "enum": ["explicit", "inferred", "structural"] },
        "source_locator": { "type": "string", "minLength": 1 },
        "accessed_at": { "$ref": "#/$defs/dateTime" },
        "claim_scope": { "type": "string", "minLength": 1 }
      },
      "required": ["project_id", "session_id", "destination", "candidate_type", "statement", "provenance", "confidence", "confidence_reason", "review_state", "conflict_refs", "approval_required", "approval_owner", "next_action"],
      "oneOf": [
        {
          "properties": { "destination": { "const": "memory" } },
          "required": ["project_scope", "explicitness"]
        },
        {
          "properties": { "destination": { "const": "library" } },
          "required": ["source_locator", "accessed_at", "claim_scope"]
        }
      ]
    },
    "evolutionRun": {
      "allOf": [{ "$ref": "#/$defs/baseRecord" }],
      "properties": {
        "record_type": { "const": "evolution_run" },
        "state_class": { "const": "derived" },
        "mode": { "enum": ["status", "suggest", "analyze", "weekly", "after_merge", "evaluate"] },
        "read_only": { "type": "boolean" },
        "input_digest": { "type": "string", "minLength": 1 },
        "result_digest": { "type": "string", "minLength": 1 }
      },
      "required": ["mode", "read_only", "input_digest", "result_digest"]
    },
    "journalEntry": {
      "type": "object",
      "required": ["sequence", "event_id", "event_type", "action", "authority_kind", "actor", "caller_type", "trust_level", "origin_ref", "subject_id", "timestamp", "command", "previous_event_digest", "payload", "payload_digest", "event_digest", "source_refs"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "event_id": { "$ref": "#/$defs/id" },
        "event_type": {
          "enum": ["import_acceptance", "session_link", "observation", "recurrence_decision", "proposal", "decision", "receipt_claim", "receipt_shown", "receipt_decision", "production_day_allocation", "mutation", "evaluation", "rollback", "tombstone"]
        },
        "action": { "type": "string", "minLength": 1 },
        "authority_kind": { "enum": ["explicit_project_user", "approved_policy", "system_observer"] },
        "actor": { "$ref": "#/$defs/id" },
        "caller_type": { "enum": ["project_user", "system", "local_agent", "remote_agent", "external_harness"] },
        "trust_level": { "enum": ["local_trusted", "remote_untrusted", "imported_untrusted"] },
        "origin_ref": { "type": "string", "minLength": 1 },
        "subject_id": { "$ref": "#/$defs/id" },
        "timestamp": { "$ref": "#/$defs/dateTime" },
        "command": { "type": "string", "minLength": 1 },
        "previous_event_digest": { "type": "string", "minLength": 1 },
        "payload": { "type": "object", "minProperties": 1 },
        "payload_digest": { "type": "string", "minLength": 1 },
        "event_digest": { "type": "string", "minLength": 1 },
        "proposal_digest": { "type": "string", "minLength": 1 },
        "source_refs": { "$ref": "#/$defs/sourceRefs" }
      },
      "allOf": [
        {
          "if": { "properties": { "authority_kind": { "const": "explicit_project_user" } }, "required": ["authority_kind"] },
          "then": {
            "properties": {
              "caller_type": { "const": "project_user" },
              "trust_level": { "const": "local_trusted" }
            }
          }
        },
        {
          "if": { "properties": { "authority_kind": { "const": "approved_policy" } }, "required": ["authority_kind"] },
          "then": {
            "properties": {
              "caller_type": { "const": "system" },
              "trust_level": { "const": "local_trusted" }
            }
          }
        },
        {
          "if": {
            "properties": { "caller_type": { "enum": ["local_agent", "remote_agent", "external_harness"] } },
            "required": ["caller_type"]
          },
          "then": { "properties": { "authority_kind": { "const": "system_observer" } } }
        },
        {
          "if": { "properties": { "action": { "enum": ["approve", "rollback"] } }, "required": ["action"] },
          "then": {
            "required": ["proposal_digest"],
            "properties": {
              "authority_kind": { "enum": ["explicit_project_user", "approved_policy"] },
              "trust_level": { "const": "local_trusted" }
            }
          }
        },
        {
          "if": { "properties": { "event_type": { "const": "decision" } }, "required": ["event_type"] },
          "then": {
            "properties": {
              "authority_kind": { "enum": ["explicit_project_user", "approved_policy"] },
              "trust_level": { "const": "local_trusted" }
            }
          }
        },
        {
          "if": {
            "properties": { "event_type": { "enum": ["mutation", "evaluation", "rollback"] } },
            "required": ["event_type"]
          },
          "then": { "required": ["proposal_digest"] }
        },
        {
          "if": {
            "properties": {
              "event_type": { "const": "decision" },
              "action": { "not": { "enum": ["approve", "rollback"] } }
            },
            "required": ["event_type", "action"]
          },
          "then": {
            "properties": {
              "authority_kind": { "const": "explicit_project_user" },
              "caller_type": { "const": "project_user" },
              "trust_level": { "const": "local_trusted" }
            }
          }
        },
        {
          "if": { "properties": { "event_type": { "const": "recurrence_decision" } }, "required": ["event_type"] },
          "then": {
            "properties": {
              "action": { "enum": ["confirm", "dismiss", "reopen"] },
              "authority_kind": { "const": "explicit_project_user" },
              "caller_type": { "const": "project_user" },
              "trust_level": { "const": "local_trusted" }
            }
          }
        },
        {
          "if": { "properties": { "event_type": { "const": "rollback" } }, "required": ["event_type"] },
          "then": {
            "properties": {
              "authority_kind": { "enum": ["explicit_project_user", "approved_policy"] },
              "trust_level": { "const": "local_trusted" }
            }
          }
        },
        {
          "if": {
            "properties": { "event_type": { "enum": ["mutation", "tombstone"] } },
            "required": ["event_type"]
          },
          "then": {
            "properties": {
              "authority_kind": { "enum": ["explicit_project_user", "approved_policy"] },
              "trust_level": { "const": "local_trusted" }
            }
          }
        },
        {
          "if": { "properties": { "event_type": { "const": "receipt_decision" } }, "required": ["event_type"] },
          "then": {
            "properties": {
              "authority_kind": { "const": "explicit_project_user" },
              "caller_type": { "const": "project_user" },
              "trust_level": { "const": "local_trusted" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_type": { "const": "session_link" },
              "action": { "const": "manual_confirmed" }
            },
            "required": ["event_type", "action"]
          },
          "then": {
            "properties": {
              "authority_kind": { "const": "explicit_project_user" },
              "caller_type": { "const": "project_user" },
              "trust_level": { "const": "local_trusted" }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "decisionEvent": {
      "properties": {
        "record_type": { "const": "decision_event" },
        "state_class": { "const": "derived" },
        "decision_kind": { "enum": ["confirm", "reject", "snooze", "approve", "rollback", "forget"] },
        "actor": { "$ref": "#/$defs/id" },
        "subject_id": { "$ref": "#/$defs/id" },
        "journal_event_id": { "$ref": "#/$defs/id" },
        "proposal_digest": { "type": "string", "minLength": 1 }
      },
      "required": ["decision_kind", "actor", "subject_id", "journal_event_id"],
      "allOf": [
        { "$ref": "#/$defs/baseRecord" },
        {
          "if": { "properties": { "decision_kind": { "enum": ["approve", "rollback"] } }, "required": ["decision_kind"] },
          "then": { "required": ["proposal_digest"] }
        }
      ]
    },
    "tombstone": {
      "allOf": [{ "$ref": "#/$defs/baseRecord" }],
      "properties": {
        "record_type": { "const": "retention_tombstone" },
        "state_class": { "const": "derived" },
        "subject_id": { "$ref": "#/$defs/id" },
        "content_digest": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "actor": { "$ref": "#/$defs/id" },
        "journal_event_id": { "$ref": "#/$defs/id" }
      },
      "required": ["subject_id", "content_digest", "reason", "actor", "journal_event_id"]
    }
  }
}
