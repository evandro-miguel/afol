{
  "hooks": [
    {
      "id": "COORDINATION-RADAR",
      "name": "coordination radar reminder",
      "path": "coordination-radar.md",
      "enabled": true,
      "events": ["context.bundle"],
      "roles": ["orchestrator"],
      "work_types": ["delivery", "all"],
      "priority": 90,
      "contributions": {
        "messages": [
          "Before delegating or editing across governed AFOL sessions, review `afol session radar` for open tasks, planned and touched files, and warnings. Radar warnings are context only, not locks; coordinate overlaps before assigning work."
        ],
        "tools": [
          "afol session radar",
          "afol session radar --json"
        ]
      }
    },
    {
      "id": "RULE-BODY-BUDGET",
      "name": "rule body budget reminder",
      "path": "rule-body-budget.md",
      "enabled": true,
      "events": ["context.bundle"],
      "surfaces": ["rules"],
      "work_types": ["delivery", "implementation", "docs", "all"],
      "file_globs": [".afol/adm/rules/**/*.md"],
      "priority": 95,
      "contributions": {
        "messages": [
          "When creating or editing AFOL rules, keep YAML frontmatter metadata-only. Rule char budgets and prompt injection use markdown body only; do not duplicate enforceable guidance in YAML."
        ],
        "validation_commands": [
          "bun test cli/tests/rule-command.test.ts cli/tests/context-system.test.ts"
        ]
      }
    }
  ]
}
