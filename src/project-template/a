#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CANONICAL_WRAPPER="${SCRIPT_DIR}/afol"

if [ -x "${CANONICAL_WRAPPER}" ]; then
  exec "${CANONICAL_WRAPPER}" "$@"
fi

if [ -f "${SCRIPT_DIR}/cli/main.ts" ] && command -v bun >/dev/null 2>&1; then
  exec bun "${SCRIPT_DIR}/cli/main.ts" "$@"
fi

if [ ! -x "${SCRIPT_DIR}/.agents/agents" ]; then
  echo "❌ Missing executable wrapper: ${SCRIPT_DIR}/.agents/agents" >&2
  exit 127
fi

exec "${SCRIPT_DIR}/.agents/agents" "$@"
