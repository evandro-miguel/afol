#!/usr/bin/env bash
#
# Agents CLI Wrapper
# Run .agents scripts with UV isolation
#
# Usage:
#   .agents/agents <script> [args...]
#   .agents/agents doctor [args...]
#   .agents/agents new <theme> --feature-id F-01 --parent-spec <spec-id> [options]
#

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -d "${SCRIPT_DIR}/current/scripts" ]; then
    SCRIPTS_DIR="${SCRIPT_DIR}/current/scripts"
else
    SCRIPTS_DIR="${SCRIPT_DIR}/scripts"
fi
ORIGINAL_PWD="$(pwd)"

resolve_python_bin() {
    if [ -n "${AGENTS_SCRIPT_PYTHON:-}" ] && [ -x "${AGENTS_SCRIPT_PYTHON}" ]; then
        echo "${AGENTS_SCRIPT_PYTHON}"
    elif [ -x "${SCRIPTS_DIR}/.venv/bin/python3" ]; then
        echo "${SCRIPTS_DIR}/.venv/bin/python3"
    elif [ -x "${SCRIPTS_DIR}/.venv/bin/python" ]; then
        echo "${SCRIPTS_DIR}/.venv/bin/python"
    elif command -v python3 >/dev/null 2>&1; then
        command -v python3
    elif command -v python >/dev/null 2>&1; then
        command -v python
    else
        echo ""
    fi
}

PYTHON_BIN="$(resolve_python_bin)"
UV_BIN="$(command -v uv 2>/dev/null || true)"

if [ -n "${AGENTS_SCRIPT_PYTHON:-}" ] && [ ! -x "${AGENTS_SCRIPT_PYTHON}" ]; then
    echo "❌ AGENTS_SCRIPT_PYTHON is not executable: ${AGENTS_SCRIPT_PYTHON}"
    exit 1
fi

resolve_uv_cache_dir() {
    if [ -n "${AGENTS_UV_CACHE_DIR:-}" ]; then
        echo "${AGENTS_UV_CACHE_DIR}"
        return 0
    fi

    if [ -n "${UV_CACHE_DIR:-}" ]; then
        echo "${UV_CACHE_DIR}"
        return 0
    fi

    local local_cache="${SCRIPT_DIR}/cache/uv"
    if mkdir -p "${local_cache}" >/dev/null 2>&1 && [ -w "${local_cache}" ]; then
        echo "${local_cache}"
        return 0
    fi

    local project_name
    project_name="$(basename "$(cd "${SCRIPT_DIR}/.." && pwd)")"
    local fallback_cache="${TMPDIR:-/tmp}/agents-uv-cache/${project_name}"
    mkdir -p "${fallback_cache}"
    echo "${fallback_cache}"
}

export UV_CACHE_DIR="$(resolve_uv_cache_dir)"

TELEMETRY_SCRIPT="${SCRIPTS_DIR}/agents-telemetry.py"
ACTIVE_SESSION_FILE="${AGENTS_ACTIVE_SESSION_FILE:-${SCRIPT_DIR}/wb/.active_session}"

# Auto-record telemetry for tool execution
record_tool_telemetry() {
    local tool_name="$1"
    local outcome="${2:-success}"
    local exit_code="${3:-0}"
    local session_id=""

    if [ -z "${PYTHON_BIN}" ]; then
        return 0
    fi

    if [ -f "${ACTIVE_SESSION_FILE}" ]; then
        session_id=$(cat "${ACTIVE_SESSION_FILE}")
    fi

    if [ -n "${session_id}" ] && [ -f "${TELEMETRY_SCRIPT}" ]; then
        "${PYTHON_BIN}" "${TELEMETRY_SCRIPT}" record tool_exec \
            --session-id="${session_id}" \
            --metadata="{\"tool_name\":\"${tool_name}\",\"outcome\":\"${outcome}\",\"exit_code\":${exit_code}}" \
            >/dev/null 2>&1 || true
    fi
}

run_and_record() {
    local tool_name="$1"
    shift

    set +e
    "$@"
    local exit_code=$?
    set -e

    if [ "${exit_code}" -eq 0 ]; then
        record_tool_telemetry "${tool_name}" "success" "${exit_code}"
    else
        record_tool_telemetry "${tool_name}" "failure" "${exit_code}"
    fi

    return "${exit_code}"
}

run_runtime_and_record() {
    local tool_name="$1"
    local runtime_entrypoint="$2"
    shift 2

    if [ -z "${UV_BIN}" ]; then
        echo "uv not found. Install with:"
        echo "   curl -LsSf https://astral.sh/uv/install.sh | sh"
        return 1
    fi

    if [ ! -d "${SCRIPT_DIR}/runtime" ]; then
        echo "Runtime package not found: ${SCRIPT_DIR}/runtime"
        return 1
    fi

    mkdir -p "${UV_CACHE_DIR}"
    cd "${ORIGINAL_PWD}"

    set +e
    "${UV_BIN}" run --project "${SCRIPT_DIR}/runtime" --locked "${runtime_entrypoint}" "$@"
    local exit_code=$?
    set -e

    if [ "${exit_code}" -eq 0 ]; then
        record_tool_telemetry "${tool_name}" "success" "${exit_code}"
    else
        record_tool_telemetry "${tool_name}" "failure" "${exit_code}"
    fi

    return "${exit_code}"
}

if [ "$#" -gt 0 ]; then
    case "$1" in
        runtime)
            shift
            if [ "$#" -eq 0 ]; then
                set -- "--help"
            fi
            run_runtime_and_record "runtime" "agentic" "$@"
            exit "$?"
            ;;
        mcp|agents-mcp)
            shift
            if [ "$#" -eq 0 ]; then
                set -- "--help"
            fi
            run_runtime_and_record "mcp" "agentic-mcp" "$@"
            exit "$?"
            ;;
        adoption-plan|inspect-target)
            COMMAND_NAME="$1"
            shift
            run_runtime_and_record "${COMMAND_NAME}" "agentic" "${COMMAND_NAME}" "$@"
            exit "$?"
            ;;
        help|-h|--help)
            ;;
    esac
fi

# Check if .venv exists
if [ ! -d "${SCRIPTS_DIR}/.venv" ] && [ -z "${AGENTS_SCRIPT_PYTHON:-}" ]; then
    if [ -z "${UV_BIN}" ]; then
        echo "❌ uv not found. Install with:"
        echo "   curl -LsSf https://astral.sh/uv/install.sh | sh"
        exit 1
    fi
    echo "⚠️  Virtualenv not found. Setting up..."
    mkdir -p "${UV_CACHE_DIR}"
    cd "${SCRIPTS_DIR}"
    "${UV_BIN}" sync
    PYTHON_BIN="$(resolve_python_bin)"
    if [ -z "${PYTHON_BIN}" ]; then
        echo "❌ Python interpreter not found after virtualenv setup"
        exit 1
    fi
    echo "✓ Setup complete"
    echo
fi

if [ -z "${PYTHON_BIN}" ]; then
    echo "❌ Python interpreter not found. Run 'just setup' to provision .agents/scripts/.venv."
    exit 1
fi

# Command map: command -> script_name (without .py)
# Aliases are handled in the case statement below
declare -A COMMAND_MAP=(
    ["doctor"]="agents-doctor"
    ["new"]="agents-new"
    ["index"]="agents-index"
    ["lint-docs"]="agents-lint-docs"
    ["lint"]="agents-lint-docs"
    ["status"]="agents-status"
    ["implement"]="agents-implement"
    ["review"]="agents-review"
    ["revert"]="agents-revert"
    ["session"]="agents-session"
    ["structure-map"]="agents-structure-map"
    ["map"]="agents-structure-map"
    ["repo-map"]="agents-repo-map"
    ["codemap"]="agents-repo-map"
    ["sync"]="sync-agent-docs"
    ["verify-tasks"]="verify-tasks"
    ["verify"]="verify-tasks"
    ["wb-update"]="agents-wb-update"
    ["wb"]="agents-wb-update"
    ["tools"]="agents-tools"
    ["telemetry"]="agents-telemetry"
    ["patterns"]="agents-patterns"
    ["knowledge"]="agents-knowledge"
    ["memory"]="agents-memory"
    ["bootstrap"]="agents-bootstrap"
    ["skills-sync"]="agents-skills-sync"
    ["fix-symlinks"]="agents-fix-symlinks"
)

render_registry_help_commands() {
    if [ -z "${UV_BIN}" ] || [ -z "${PYTHON_BIN}" ] || [ ! -d "${SCRIPT_DIR}/runtime" ]; then
        return 1
    fi

    local payload=""
    if ! payload="$("${UV_BIN}" run --project "${SCRIPT_DIR}/runtime" --locked agentic command-registry 2>/dev/null)"; then
        return 1
    fi

    if ! printf '%s' "${payload}" | "${PYTHON_BIN}" -c '
import json
import sys

try:
    registry = json.load(sys.stdin)
except json.JSONDecodeError:
    raise SystemExit(1)

commands = registry.get("help_commands")
if not isinstance(commands, list):
    raise SystemExit(1)

for item in commands:
    name = str(item.get("name", "")).strip()
    description = str(item.get("description", "")).strip()
    aliases = item.get("aliases")
    if not name or not description:
        continue
    alias_suffix = ""
    if isinstance(aliases, list) and aliases:
        alias_suffix = " (aliases: " + ", ".join(str(alias) for alias in aliases) + ")"
    print(f"  {name:<18}{description}{alias_suffix}")
'; then
        return 1
    fi
}

# Help message
show_help() {
    echo "Agents CLI - Operational scripts for .agents system"
    echo
    echo "Usage:"
    echo "  .agents/agents <command> [args...]"
    echo
    echo "Commands:"
    if ! render_registry_help_commands; then
        echo "  doctor              Validate .agents structure and integrity"
        echo "  new                 Create new governed workstreams"
        echo "  index               Update specs and decision indexes"
        echo "  lint-docs           Validate markdown docs consistency"
        echo "  status              Show workstream status summary and artifact readiness"
        echo "  implement           Execute governed task transitions"
        echo "  review              Review governed execution state"
        echo "  revert              Revert logical work units"
        echo "  session             Catch up or close governed workbench sessions"
        echo "  structure-map       Generate project structure documentation"
        echo "  repo-map            Generate or refresh docs/map codemap output"
        echo "  sync                Sync AGENTS.md runtime mirrors"
        echo "  verify-tasks        Verify workbench task completion"
        echo "  wb-update           Update workbench metadata and evidence"
        echo "  tools               Discover and validate tool catalog entries"
        echo "  telemetry           Query and record telemetry"
        echo "  patterns            Discover and apply reusable patterns"
        echo "  knowledge           Search and pull reusable workbench knowledge"
        echo "  memory              Emit governed external-memory MCP contracts"
        echo "  bootstrap           Install the scaffold into another repository"
        echo "  skills-sync         Sync project skills from universal-skills"
        echo "  fix-symlinks        Repair symlinks with copy fallback"
    fi
    echo "  runtime             Run the central .agents/runtime CLI"
    echo "  mcp                 Run the FastMCP-backed runtime CLI"
    echo "  help                Show this help message"
    echo
    echo "Examples:"
    echo "  .agents/agents doctor"
    echo "  .agents/agents new auth-refactor --feature-id F-01 --parent-spec my-parent-spec --spec"
    echo "  .agents/agents structure-map . --output docs/map/structure/"
    echo "  .agents/agents repo-map ."
    echo "  .agents/agents verify-tasks .agents/wb/260223_1200_auth-refactor/"
    echo "  .agents/agents status --session 260223_1200_auth-refactor"
    echo "  .agents/agents implement next --session 260306_2128_context-driven-execution-commands"
    echo "  .agents/agents review --session 260306_2128_context-driven-execution-commands"
    echo "  .agents/agents revert task --session 260306_2128_context-driven-execution-commands --task-id T-04 --to-state pending --confirm"
    echo "  .agents/agents session catchup --session 260306_2128_context-driven-execution-commands"
    echo "  .agents/agents session close --session 260306_2128_context-driven-execution-commands --next-session 260306_2240_session-close-command"
    echo "  .agents/agents wb-update touch"
    echo "  .agents/agents wb-update evidence T-01 --session <id> --command \"just test-scripts\" --result \"passed\""
    echo "  .agents/agents wb-update task T-01 --session <id> --mark-done --evidence-id E-YYYY..."
    echo "  .agents/agents tools list"
    echo "  .agents/agents tools info doctor"
    echo "  .agents/agents tools search validate"
    echo "  .agents/agents telemetry heat --period weekly"
    echo "  .agents/agents patterns suggest --theme auth"
    echo "  .agents/agents knowledge pull runtime"
    echo "  .agents/agents memory search \"agent memory\" --runtime codex"
    echo "  .agents/agents runtime manifest"
    echo "  .agents/agents mcp validate"
    echo "  .agents/agents bootstrap /path/to/target-repo --dry-run"
    echo "  .agents/agents skills-sync status"
    echo "  .agents/agents fix-symlinks --dry-run"
}

# Parse command
COMMAND="$1"
shift || true

# Handle help and empty command first
if [ "${COMMAND}" = "help" ] || [ "${COMMAND}" = "-h" ] || [ "${COMMAND}" = "--help" ]; then
    show_help
    exit 0
fi

if [ -z "${COMMAND}" ]; then
    echo "❌ No command specified"
    echo
    echo "Run '.agents/agents help' for usage"
    exit 1
fi

# Look up command in map
SCRIPT_NAME="${COMMAND_MAP[${COMMAND}]:-}"

if [ -n "${SCRIPT_NAME}" ]; then
    # Command found in map
    if [ -f "${SCRIPTS_DIR}/${SCRIPT_NAME}.py" ]; then
        cd "${ORIGINAL_PWD}"
        run_and_record "${COMMAND}" "${PYTHON_BIN}" "${SCRIPTS_DIR}/${SCRIPT_NAME}.py" "$@"
        exit_code=$?
        if [ "${exit_code}" -ne 0 ]; then
            exit "${exit_code}"
        fi
    else
        record_tool_telemetry "${COMMAND}" "failure" "127"
        echo "❌ Script not found: ${SCRIPT_NAME}.py"
        exit 1
    fi
elif [ -f "${SCRIPTS_DIR}/${COMMAND}.py" ]; then
    # Try to run as script name directly (fallback for unknown commands)
    cd "${ORIGINAL_PWD}"
    run_and_record "${COMMAND}" "${PYTHON_BIN}" "${SCRIPTS_DIR}/${COMMAND}.py" "$@"
    exit_code=$?
    if [ "${exit_code}" -ne 0 ]; then
        exit "${exit_code}"
    fi
else
    echo "❌ Unknown command: ${COMMAND}"
    echo
    echo "Run '.agents/agents help' for usage"
    exit 1
fi
