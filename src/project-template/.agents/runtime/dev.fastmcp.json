{
  "$schema": "https://gofastmcp.com/public/schemas/fastmcp.json/v1.json",
  "source": {
    "type": "filesystem",
    "path": "src/agentic_scaffold/server.py",
    "entrypoint": "mcp"
  },
  "environment": {
    "type": "uv",
    "python": "3.11",
    "project": ".",
    "editable": ["."]
  },
  "deployment": {
    "transport": "streamable-http",
    "host": "127.0.0.1",
    "port": 7700,
    "path": "/mcp/",
    "log_level": "DEBUG",
    "cwd": "."
  }
}
