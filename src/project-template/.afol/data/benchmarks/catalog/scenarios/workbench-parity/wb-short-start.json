      "bun",
      "-e",
      "const{readFileSync:r,rmSync,writeFileSync:w}=require('node:fs');const{join}=require('node:path');const root=process.cwd(),session='sb-short-start',branch=r(join(root,'.git','HEAD'),'utf8').trim().replace('ref: refs/heads/','');w(join(root,'.afol','wb','session-context.json'),JSON.stringify({bindings:[{session,branch,worktree:root,actor:null,last_touched:new Date().toISOString()}]})+'\\n','utf8');rmSync(join(root,'.afol','wb','.active_session'));"
    ],
    [
      "bun",
      "-e",
      "const {rmSync}=require('node:fs'); for (const path of ['cli','src','docs','tests','.claude']) rmSync(path,{recursive:true,force:true});"
