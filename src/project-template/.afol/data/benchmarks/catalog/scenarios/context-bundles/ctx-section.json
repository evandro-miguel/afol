{
  "schema_version": "1.0.0",
  "scenario_id": "ctx-section",
  "scenario_version": "1.0.0",
  "pack_id": "context-bundles",
  "command": "afol cx section --ref spec:alpha#overview",
  "sandbox": true,
  "setup": [
    [
      "node",
      "-e",
      "const {mkdirSync,writeFileSync}=require('node:fs'); const {join}=require('node:path'); const root=process.cwd(); const dir=join(root,'.afol','adm','specs'); mkdirSync(dir,{recursive:true}); writeFileSync(join(dir,'alpha-spec.md'), ['---','doc_type: spec','id: alpha','roadmap_feature: alpha','status: active','---','','# Alpha','','## Overview','','Alpha overview.',''].join('\\n'),'utf8');"
    ],
    [
      "afol",
      "cx",
      "build"
    ]
  ],
  "result_schema": "1.0.0",
  "oracle": "normalized-envelope-and-threshold-check",
  "thresholds": {
    "max_duration_ms": 300,
    "max_p95_ms": 300,
    "max_output_tokens": 50,
    "min_tool_success_rate": 0.98
  },
  "baseline_id": "context-bundles-v1",
  "deterministic_metrics": {
    "duration_ms": 120,
    "timing_p50_ms": 110,
    "timing_p95_ms": 160,
    "error_count": 0,
    "retry_count": 0,
    "context_tokens": 180,
    "prompt_tokens": 0,
    "output_tokens": 42,
    "context_bytes": 1024,
    "output_bytes": 240,
    "tool_call_count": 1,
    "tool_success_rate": 1
  },
  "implementation_status": "implemented"
}
