# Agents scripts virtualenv (isolated per project)
.agents/scripts/.venv/
.agents/runtime/.venv/
.agents/scripts/*.egg-info/

# UV lock files (optional: commit for reproducible builds)
.agents/scripts/uv.lock
uv.lock
!.agents/runtime/uv.lock
!src/project-template/.agents/runtime/uv.lock

# Python cache
.agents/scripts/__pycache__/
.agents/scripts/*.pyc
**/__pycache__/
**/*.pyc

# Structure map cache
.agents/arc/structure/.structure-cache.json
**/.structure-cache.json

# Runtime telemetry events (operational data)
.agents/data/telemetry/events.jsonl
.agents/data/benchmarks/results/*

# Runtime/cache snapshots
.agents/.cache/
.agents/tools/uv/
src/project-template/.agents/tmp/
.agents/journal/

# Universal-skills must not be a repo-local git cache or nested checkout.
.agents/cache/universal-skills/

# Local temporary/reference workspace
.agents/.tmp/
.agents/tmp/*
!.agents/tmp/README.md
.worktree/

# Archived workstream payloads; keep the placeholder only.
.agents/z-arq/*
!.agents/z-arq/README.md

# Legacy/generated local map output; current-state repo maps live in docs/map/
.agents/arc/map/

# Generated repo-map evidence; regenerate on demand instead of committing.
docs/map/extra/

# Legacy implementation report generated during migration work.
docs/telemetry/reports/implementation_report.md

# Workbench sessions (operational state; should not be cloned)
.agents/wb/

# Local coverage artifact
.coverage

# Makefile in a-docs (keep root Makefile)
# .agents/a-docs/standards/Makefile
.gitnexus
.agents/tmp/
