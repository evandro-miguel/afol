# Legacy Python/runtime surfaces are retired. Do not recreate
# .agents/scripts, .agents/runtime, .agents/wb, or .agents/z-arq.

# UV lock files
uv.lock

# Python cache
**/__pycache__/
**/*.pyc

# Local linter/tool caches
.pytest_cache/
.ruff_cache/
.rumdl_cache/
.codex/

# Structure map cache
**/.structure-cache.json

# AFOL mutable data
.afol/pstr/*
!.afol/pstr/
.afol/state/*
!.afol/state/
.afol/data/events/
.afol/data/index/
.afol/data/session/
.afol/data/mutations/
.afol/data/migrations/*
.afol/data/benchmarks/catalog/results/*
!.afol/data/migrations/
!.afol/data/migrations/legacy-system-retirement-260609/
!.afol/data/migrations/legacy-system-retirement-260609/z-arq-README.md
.afol/data/migrations/legacy-system-retirement-260609/legacy-*/

src/project-template/.afol/tmp/*
!src/project-template/.afol/tmp/
!src/project-template/.afol/tmp/README.md

src/project-template/.afol/data/events/*
src/project-template/.afol/data/index/*
!src/project-template/.afol/data/events/
!src/project-template/.afol/data/events/README.md
!src/project-template/.afol/data/index/
!src/project-template/.afol/data/index/README.md

# Universal-skills must not be a repo-local git cache or nested checkout.
.agents/cache/universal-skills/

# Local temporary/reference workspace
.tmp/
.afol/tmp/*
!.afol/tmp/
!.afol/tmp/README.md

# External harness transcripts stay local; only the policy README is versioned.
.afol/external/*
!.afol/external/
!.afol/external/README.md
src/project-template/.afol/external/*
!src/project-template/.afol/external/
!src/project-template/.afol/external/README.md

# Generated repo-map evidence; regenerate on demand instead of committing.
docs/map/extra/

# Legacy implementation report generated during migration work.
docs/telemetry/reports/implementation_report.md

.afol/wb/.active_session
.afol/wb/session-context.json
.afol/wb/.locks/

# Legacy nested worktrees; Worktrunk standard uses grouped siblings.
.worktree/

# Local coverage artifact
.coverage

# Local secrets
.env
.env.local
.env.*.local

# Makefile in a-docs (keep root Makefile)
# .agents/a-docs/standards/Makefile
.gitnexus

# Generated install/build outputs
node_modules/
dist/
.bun-build*

# Reproducible source artifacts that must stay versioned
!bun.lock
!cli/generated/template.ts
