# Example ignore file for local agent workspaces
# Copy/merge into your local .gitignore after cloning this repository.

# Agents scripts virtualenv and caches
.agents/scripts/.venv/
.agents/scripts/uv.lock
uv.lock
.agents/scripts/__pycache__/
.agents/scripts/*.pyc
**/__pycache__/
**/*.pyc

# Structure map cache
.agents/arc/structure/.structure-cache.json
**/.structure-cache.json

# Runtime telemetry events
.agents/data/telemetry/events.jsonl

# Local temporary/reference workspace
.agents/.tmp/

# Workbench sessions (operational state)
.agents/wb/

# Local coverage artifact
.coverage
