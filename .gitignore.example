# Example ignore file for local AFOL workspaces.
# Copy or merge into your local .gitignore after cloning this repository.

# AFOL mutable state
.afol/pstr/*
!.afol/pstr/
.afol/state/*
!.afol/state/
.afol/data/events/
.afol/data/index/
.afol/data/session/
.afol/data/mutations/
.afol/data/migrations/*
!.afol/data/migrations/
!.afol/data/migrations/legacy-system-retirement-260609/
!.afol/data/migrations/legacy-system-retirement-260609/z-arq-README.md
.afol/data/migrations/legacy-system-retirement-260609/legacy-*/
.afol/data/benchmarks/catalog/results/*
.afol/wb/.active_session
.afol/tmp/*
!.afol/tmp/
!.afol/tmp/README.md

# Generic local/generated artifacts
**/.structure-cache.json
.DS_Store
node_modules/
dist/
.bun-build*
.coverage
