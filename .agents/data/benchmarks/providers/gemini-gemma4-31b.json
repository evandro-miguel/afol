{
  "schema_version": "1.0.0",
  "id": "gemini-gemma4-31b",
  "runtime": "gemini-api",
  "provider": "google-gemini",
  "model": "gemma-4-31b-it",
  "api_key_env": "GEMINI_API_KEY",
  "endpoint": "https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent",
  "generation": {
    "temperature": 0.1,
    "top_p": 0.95,
    "max_output_tokens": 8192
  },
  "rate_limits": {
    "rpm": 15,
    "rpd": 1500,
    "min_request_interval_ms": 4100
  },
  "request_budget": {
    "max_requests_per_scenario": 12,
    "max_requests_per_suite": 12,
    "allow_recovery_request": false
  },
  "capabilities": {
    "text_only": true,
    "tool_loop": "provider_agent_sdk_local_tools",
    "structured_json": true,
    "tools": [
      "list_dir",
      "read_file",
      "write_file",
      "run_shell"
    ],
    "progress_log": "agent_progress"
  },
  "ledger": {
    "path": ".afol/tmp/benchmarks/gemini-rate-ledger.jsonl"
  }
}
