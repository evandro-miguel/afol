# Parse command
COMMAND="$1"
shift || true

# Handle help and empty command first
if [ "${COMMAND}" = "help" ] || [ "${COMMAND}" = "-h" ] || [ "${COMMAND}" = "--help" ]; then
    show_help
    exit 0
fi

if [ -z "${COMMAND}" ]; then
    echo "❌ No command specified"
    echo
    echo "Run '.agents/agents help' for usage"
    exit 1
fi

# Look up command in map
SCRIPT_NAME="${COMMAND_MAP[${COMMAND}]:-}"

if [ -n "${SCRIPT_NAME}" ]; then
    # Command found in map
    if [ -f "${SCRIPTS_DIR}/${SCRIPT_NAME}.py" ]; then
        cd "${ORIGINAL_PWD}"
        run_and_record "${COMMAND}" "${PYTHON_BIN}" "${SCRIPTS_DIR}/${SCRIPT_NAME}.py" "$@"
        exit_code=$?
        if [ "${exit_code}" -ne 0 ]; then
            exit "${exit_code}"
        fi
    else
        record_tool_telemetry "${COMMAND}" "failure" "127"
        echo "❌ Script not found: ${SCRIPT_NAME}.py"
        exit 1
    fi
elif [ -f "${SCRIPTS_DIR}/${COMMAND}.py" ]; then
    # Try to run as script name directly (fallback for unknown commands)
    cd "${ORIGINAL_PWD}"
    run_and_record "${COMMAND}" "${PYTHON_BIN}" "${SCRIPTS_DIR}/${COMMAND}.py" "$@"
    exit_code=$?
    if [ "${exit_code}" -ne 0 ]; then
        exit "${exit_code}"
    fi
else
    echo "❌ Unknown command: ${COMMAND}"
    echo
    echo "Run '.agents/agents help' for usage"
    exit 1
fi
