render_registry_help_commands() {
    if [ -z "${UV_BIN}" ] || [ -z "${PYTHON_BIN}" ] || [ ! -d "${SCRIPT_DIR}/runtime" ]; then
        return 1
    fi

    local payload=""
    mkdir -p "${SCRIPT_DIR}/tmp"
    if ! payload="$("${UV_BIN}" run --project "${SCRIPT_DIR}/runtime" --locked agentic command-registry 2>"${SCRIPT_DIR}/tmp/command-registry-help.log")"; then
        return 1
    fi

    if ! printf '%s' "${payload}" | "${PYTHON_BIN}" -c '
import json
import sys

try:
    registry = json.load(sys.stdin)
except json.JSONDecodeError:
    raise SystemExit(1)

commands = registry.get("help_commands")
if not isinstance(commands, list):
    raise SystemExit(1)

for item in commands:
    name = str(item.get("name", "")).strip()
    description = str(item.get("description", "")).strip()
    aliases = item.get("aliases")
    if not name or not description:
        continue
    alias_suffix = ""
    if isinstance(aliases, list) and aliases:
        alias_suffix = " (aliases: " + ", ".join(str(alias) for alias in aliases) + ")"
    print(f"  {name:<18}{description}{alias_suffix}")
'; then
        return 1
    fi
}

