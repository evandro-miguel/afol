    ["codemap"]="agents-repo-map"
    ["sync"]="sync-agent-docs"
    ["verify-tasks"]="verify-tasks"
    ["verify"]="verify-tasks"
    ["wb-update"]="agents-wb-update"
    ["wb"]="agents-wb-update"
