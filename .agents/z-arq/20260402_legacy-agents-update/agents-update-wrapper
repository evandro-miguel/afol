#!/bin/bash
# Agentic System Update CLI wrapper
# Usage: ./.agents/agents-update [command] [options]

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "${SCRIPT_DIR}/current/scripts/agents-update/agents-update.py" ]; then
  SCRIPT_PATH="${SCRIPT_DIR}/current/scripts/agents-update/agents-update.py"
else
  SCRIPT_PATH="${SCRIPT_DIR}/scripts/agents-update/agents-update.py"
fi
exec python3 "${SCRIPT_PATH}" "$@"
