new:
  @if [ -z "${THEME:-}" ]; then \
    echo "╔═══════════════════════════════════════════════════════════╗"; \
    echo "║  Error: THEME required                                    ║"; \
    echo "╠═══════════════════════════════════════════════════════════╣"; \
    echo "║  Usage: just new THEME=<theme> FEATURE_ID=F-01            ║"; \
    echo "║         PARENT_SPEC=<parent-spec-id> [SPEC=1|lite]        ║"; \
    echo "║         [INTENT=delivery|research|...] [WITH=a,b]         ║"; \
    echo "║                                                           ║"; \
    echo "║  Examples:                                                ║"; \
    echo "║    just new THEME=auth-refactor FEATURE_ID=F-01          ║"; \
    echo "║      PARENT_SPEC=my-parent-spec                           ║"; \
    echo "║    just new THEME=api-endpoint FEATURE_ID=F-02           ║"; \
    echo "║      PARENT_SPEC=my-parent-spec SPEC=1                    ║"; \
    echo "║    just new THEME=auth-investigation FEATURE_ID=F-03     ║"; \
    echo "║      PARENT_SPEC=my-parent-spec INTENT=research           ║"; \
    echo "╚═══════════════════════════════════════════════════════════╝"; \
    exit 1; \
  fi; \
  if [ -z "${FEATURE_ID:-}" ] || [ -z "${PARENT_SPEC:-}" ]; then \
    echo "Usage: just new THEME=<theme> FEATURE_ID=F-01 PARENT_SPEC=<parent-spec-id> [SPEC=1|lite] [INTENT=delivery|research|planning|brainstorming|exploration|specification|closure] [WITH=doc1,doc2] [CHILD_SPEC=<child-spec-id>]"; \
    exit 1; \
  fi; \
  echo "→ Creating workstream: ${THEME}..."; \
  cmd=(./.agents/agents new "${THEME}" --feature-id "${FEATURE_ID}" --parent-spec "${PARENT_SPEC}"); \
  if [ -n "${CHILD_SPEC:-}" ]; then cmd+=(--child-spec "${CHILD_SPEC}"); fi; \
  if [ -n "${INTENT:-}" ]; then cmd+=(--intent "${INTENT}"); fi; \
  if [ -n "${WITH:-}" ]; then \
    while IFS= read -r with_item; do \
      if [ -n "${with_item}" ]; then cmd+=(--with "${with_item}"); fi; \
    done < <(printf '%s' "${WITH}" | tr ',' '\n'); \
  fi; \
  if [ "${SPEC:-}" = "1" ]; then \
    cmd+=(--spec); \
  elif [ "${SPEC:-}" = "lite" ]; then \
    cmd+=(--spec-lite); \
  fi; \
  "${cmd[@]}"; \
  echo "✓ Workstream created: ${THEME}"

quick:
