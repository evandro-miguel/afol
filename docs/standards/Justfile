  @UV_CACHE_DIR="{{uv_cache_dir}}" uv run --project .agents/scripts pytest .agents/scripts/tests/integration
  @echo "✓ Script integration tests passed"

test-scripts-all:
  @echo "→ Running full script test suite with 80% coverage gate..."
  @mkdir -p "{{uv_cache_dir}}"
  @UV_CACHE_DIR="{{uv_cache_dir}}" uv run --project .agents/scripts pytest .agents/scripts/tests -m "not e2e" --cov=.agents/scripts --cov-config=.agents/scripts/pyproject.toml --cov-report=term-missing --cov-fail-under=80
  @echo "✓ Full script test suite and coverage gate passed"

lint-scripts:
