  @mkdir -p "{{uv_cache_dir}}"
  @cd .agents/scripts && UV_CACHE_DIR="{{uv_cache_dir}}" uv run ruff check .
  @echo "✓ Python scripts linted"

lint-runtime:
  @echo "→ Linting central runtime package..."
  @mkdir -p "{{uv_cache_dir}}"
  @UV_CACHE_DIR="{{uv_cache_dir}}" uv run --project .agents/runtime --locked ruff check .agents/runtime
