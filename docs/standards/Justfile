wb-touch:
  @if [ -z "${SESSION_ID:-}" ]; then echo "Usage: just wb-touch SESSION_ID=<session-id> [FILE=<path>]"; exit 1; fi
  @if [ -n "${FILE:-}" ]; then \
    ./.agents/agents wb-update touch --session "${SESSION_ID}" --file "${FILE}"; \
  else \
    ./.agents/agents wb-update touch --session "${SESSION_ID}"; \
  fi

wb-normalize-time:
  @if [ -z "${SESSION_ID:-}${FILE:-}${ALL_WB:-}" ]; then echo "Usage: just wb-normalize-time SESSION_ID=<session-id> | FILE=<path> | ALL_WB=1"; exit 1; fi
  @if [ -n "${FILE:-}" ]; then \
    ./.agents/agents wb-update normalize-time --file "${FILE}"; \
  elif [ "${ALL_WB:-}" = "1" ]; then \
    ./.agents/agents wb-update normalize-time --all-wb; \
  else \
    ./.agents/agents wb-update normalize-time --session "${SESSION_ID}"; \
  fi

wb-files-changed:
  @if [ -z "${SESSION_ID:-}${REPORT:-}" ]; then echo "Usage: just wb-files-changed SESSION_ID=<session-id> [INCLUDE_WB=1] | REPORT=<report-file>"; exit 1; fi
  @if [ -n "${REPORT:-}" ]; then \
    cmd=(./.agents/agents wb-update files-changed --report "${REPORT}"); \
  else \
    cmd=(./.agents/agents wb-update files-changed --session "${SESSION_ID}"); \
  fi; \
  if [ -n "${INCLUDE_WB:-}" ]; then cmd+=(--include-wb); fi; \
  "${cmd[@]}"

wb-evidence:
  @if [ -z "${SESSION_ID:-}" ] || [ -z "${TASK_ID:-}" ] || [ -z "${CMD:-}" ] || [ -z "${RESULT:-}" ]; then echo "Usage: just wb-evidence SESSION_ID=<session-id> TASK_ID=T-01 CMD=\"...\" RESULT=\"...\" [ARTIFACT=<path>] [NOTE=\"...\"]"; exit 1; fi
  @cmd=(./.agents/agents wb-update evidence "${TASK_ID}" --session "${SESSION_ID}" --command "${CMD}" --result "${RESULT}"); \
  if [ -n "${ARTIFACT:-}" ]; then cmd+=(--artifact "${ARTIFACT}"); fi; \
  if [ -n "${NOTE:-}" ]; then cmd+=(--note "${NOTE}"); fi; \
  "${cmd[@]}"

wb-task:
  @if [ -z "${SESSION_ID:-}" ] || [ -z "${TASK_ID:-}" ]; then echo "Usage: just wb-task SESSION_ID=<session-id> TASK_ID=T-01 ACTION=done|in_progress|pending|ready|blocked|skipped [EVIDENCE_ID=E-...] [ALLOW_UNSAFE_DONE=1]"; exit 1; fi
  @if [ "${ACTION:-}" = "done" ]; then \
    if [ -n "${EVIDENCE_ID:-}" ]; then \
      ./.agents/agents wb-update task "${TASK_ID}" --session "${SESSION_ID}" --mark-done --evidence-id "${EVIDENCE_ID}"; \
    elif [ "${ALLOW_UNSAFE_DONE:-}" = "1" ]; then \
      ./.agents/agents wb-update task "${TASK_ID}" --session "${SESSION_ID}" --mark-done --allow-unsafe-done; \
    else \
      echo "ACTION=done requires EVIDENCE_ID. Use just wb-evidence first or set ALLOW_UNSAFE_DONE=1"; \
      exit 1; \
    fi; \
  elif [ "${ACTION:-}" = "in_progress" ]; then \
    ./.agents/agents wb-update task "${TASK_ID}" --session "${SESSION_ID}" --mark-in-progress; \
  elif [ "${ACTION:-}" = "pending" ]; then \
    ./.agents/agents wb-update task "${TASK_ID}" --session "${SESSION_ID}" --mark-pending; \
  elif [ "${ACTION:-}" = "ready" ]; then \
    ./.agents/agents wb-update task "${TASK_ID}" --session "${SESSION_ID}" --mark-ready; \
  elif [ "${ACTION:-}" = "blocked" ]; then \
    ./.agents/agents wb-update task "${TASK_ID}" --session "${SESSION_ID}" --mark-blocked; \
  elif [ "${ACTION:-}" = "skipped" ]; then \
    ./.agents/agents wb-update task "${TASK_ID}" --session "${SESSION_ID}" --mark-skipped; \
  else \
    echo "Invalid ACTION=${ACTION:-}"; \
    echo "Use one of: done, in_progress, pending, ready, blocked, skipped"; \
    exit 1; \
  fi

wb-status:
  @if [ -z "${SESSION_ID:-}" ] || [ -z "${STATUS:-}" ]; then echo "Usage: just wb-status SESSION_ID=<session-id> STATUS=<value> [FILE=plan|task|spec-lite|report|log|all]"; exit 1; fi
  @./.agents/agents wb-update status --session "${SESSION_ID}" --value "${STATUS}" --file "${FILE:-all}"

wb-timeline:
  @if [ -z "${SESSION_ID:-}" ] || [ -z "${MSG:-}" ]; then echo "Usage: just wb-timeline SESSION_ID=<session-id> MSG=\"your message\""; exit 1; fi
  @./.agents/agents wb-update timeline --session "${SESSION_ID}" --message "${MSG}"

wb-link:
  @if [ -z "${SESSION_ID:-}" ] || [ -z "${FILE:-}" ] || [ -z "${KEY:-}" ] || [ -z "${VALUE:-}" ]; then echo "Usage: just wb-link SESSION_ID=<session-id> FILE=plan|task|spec-lite|report|log KEY=<key> VALUE=<value>"; exit 1; fi
  @./.agents/agents wb-update link --session "${SESSION_ID}" --file "${FILE}" --key "${KEY}" --value "${VALUE}"

telemetry-record:
  @echo "→ Recording telemetry event..."
  @cmd=({{python_bin}} .agents/scripts/agents-telemetry.py record); \
  if [ -n "${EVENT_TYPE:-}" ]; then cmd+=("${EVENT_TYPE}"); fi; \
  if [ -n "${SESSION_ID:-}" ]; then cmd+=(--session-id="${SESSION_ID}"); fi; \
  if [ -n "${METADATA:-}" ]; then cmd+=(--metadata="${METADATA}"); fi; \
  if [ -n "${OUTCOME:-}" ]; then cmd+=(--outcome="${OUTCOME}"); fi; \
  "${cmd[@]}"

telemetry-report:
  @echo "→ Generating telemetry report..."
  @{{python_bin}} .agents/scripts/agents-telemetry.py report --period="${PERIOD:-weekly}" --format="${FORMAT:-text}"

telemetry-export:
  @echo "→ Exporting telemetry data..."
  @cmd=({{python_bin}} .agents/scripts/agents-telemetry.py export --format="${FORMAT:-json}"); \
  if [ -n "${OUTPUT:-}" ]; then cmd+=(--output="${OUTPUT}"); fi; \
  "${cmd[@]}"

telemetry-validate:
  @echo "→ Validating telemetry data..."
  @{{python_bin}} .agents/scripts/agents-telemetry.py validate

telemetry-heat:
  @echo "→ Generating heat map..."
  @cmd=({{python_bin}} .agents/scripts/agents-telemetry.py heat); \
  if [ -n "${TYPE:-}" ]; then cmd+=(--type="${TYPE}"); fi; \
  if [ -n "${FORMAT:-}" ]; then cmd+=(--format="${FORMAT}"); fi; \
  if [ -n "${MIN_SCORE:-}" ]; then cmd+=(--min-score="${MIN_SCORE}"); fi; \
  if [ -n "${PERIOD:-}" ]; then cmd+=(--period="${PERIOD}"); fi; \
  "${cmd[@]}"

telemetry-hot:
  @echo "→ Showing hottest elements..."
  @cmd=({{python_bin}} .agents/scripts/agents-telemetry.py hot); \
  if [ -n "${LIMIT:-}" ]; then cmd+=(--limit="${LIMIT}"); fi; \
  if [ -n "${TYPE:-}" ]; then cmd+=(--type="${TYPE}"); fi; \
  if [ -n "${PERIOD:-}" ]; then cmd+=(--period="${PERIOD}"); fi; \
  "${cmd[@]}"

telemetry-cold:
  @echo "→ Showing coldest elements..."
  @cmd=({{python_bin}} .agents/scripts/agents-telemetry.py cold); \
  if [ -n "${LIMIT:-}" ]; then cmd+=(--limit="${LIMIT}"); fi; \
  if [ -n "${TYPE:-}" ]; then cmd+=(--type="${TYPE}"); fi; \
  if [ -n "${PERIOD:-}" ]; then cmd+=(--period="${PERIOD}"); fi; \
  "${cmd[@]}"

patterns-suggest:
  @echo "→ Suggesting patterns..."
  @cmd=({{python_bin}} .agents/scripts/agents-patterns.py suggest); \
  if [ -n "${THEME:-}" ]; then cmd+=(--theme="${THEME}"); fi; \
  if [ -n "${TAGS:-}" ]; then cmd+=(--tags="${TAGS}"); fi; \
  if [ -n "${LIMIT:-}" ]; then cmd+=(--limit="${LIMIT}"); fi; \
  "${cmd[@]}"

patterns-list:
  @echo "→ Listing patterns..."
  @cmd=({{python_bin}} .agents/scripts/agents-patterns.py list); \
  if [ -n "${TYPE:-}" ]; then cmd+=(--type="${TYPE}"); fi; \
  if [ -n "${STATUS:-}" ]; then cmd+=(--status="${STATUS}"); fi; \
  "${cmd[@]}"

patterns-show:
  @if [ -z "${PATTERN_ID:-}" ]; then echo "Usage: just patterns-show PATTERN_ID=PAT-001"; exit 1; fi
  @{{python_bin}} .agents/scripts/agents-patterns.py show "${PATTERN_ID}"

patterns-apply:
  @if [ -z "${PATTERN_ID:-}" ]; then echo "Usage: just patterns-apply PATTERN_ID=PAT-001 [SESSION=xxx]"; exit 1; fi
  @cmd=({{python_bin}} .agents/scripts/agents-patterns.py apply "${PATTERN_ID}"); \
  if [ -n "${SESSION:-}" ]; then cmd+=(--session="${SESSION}"); fi; \
  "${cmd[@]}"

patterns-rate:
  @if [ -z "${PATTERN_ID:-}" ] || [ -z "${EFFECTIVENESS:-}" ]; then echo "Usage: just patterns-rate PATTERN_ID=PAT-001 EFFECTIVENESS=high|medium|low"; exit 1; fi
  @{{python_bin}} .agents/scripts/agents-patterns.py rate "${PATTERN_ID}" --effectiveness="${EFFECTIVENESS}"
