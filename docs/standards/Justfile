memory-search:
  @if [ -z "${QUERY:-}" ]; then echo "Usage: just memory-search QUERY=<term> [RUNTIME=<runtime>] [PROJECT=<project>] [LIMIT=<n>]"; exit 1; fi
  @cmd=(./.agents/agents memory search "${QUERY}"); \
  if [ -n "${RUNTIME:-}" ]; then cmd+=(--runtime "${RUNTIME}"); fi; \
  if [ -n "${PROJECT:-}" ]; then cmd+=(--project "${PROJECT}"); fi; \
  if [ -n "${LIMIT:-}" ]; then cmd+=(--limit "${LIMIT}"); fi; \
  "${cmd[@]}"

memory-context:
