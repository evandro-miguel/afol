  @cmd=(./.agents/agents bootstrap "${TARGET}"); \
  if [ -n "${PARTIAL:-}" ]; then cmd+=(--partial); fi; \
  if [ -n "${FORCE:-}" ]; then cmd+=(--force); fi; \
  if [ -n "${DRY:-}" ]; then cmd+=(--dry-run); fi; \
  if [ -n "${SKIP_CHECKS:-}" ]; then cmd+=(--skip-checks); fi; \
  "${cmd[@]}"

